{
  "buildCommand": "cd packages/website && npm run docs:build",
  "outputDirectory": "packages/website/.vitepress/dist",
  "installCommand": "cd packages/website && npm install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/packages/website/.vitepress/dist/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html|.*\\.css|.*\\.js|.*\\.woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}

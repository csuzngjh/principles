{
  "name": "@principles/pd-cli",
  "version": "1.158.7",
  "description": "PD CLI — Pain recording, sample management, and governance tasks for Principles Disciple",
  "type": "module",
  "bin": {
    "pd": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node ../../scripts/build/check-dist-hygiene.mjs",
    "clean": "node ../../scripts/build/clean-dist.mjs",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@principles/core": "^1.296.0",
    "@principles/codex-adapter": "^0.5.12",
    "@principles/workbuddy-adapter": "^0.2.10",
    "@principles/host-runtime": "^0.13.0",
    "@principles/install-layout": "^0.4.0",
    "principles-disciple": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuzngjh/principles.git",
    "directory": "packages/pd-cli"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@principles/pd-cli",
  "version": "1.152.12",
  "description": "PD CLI — Pain recording, sample management, and governance tasks for Principles Disciple",
  "type": "module",
  "bin": {
    "pd": "dist/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node ../../scripts/build/check-dist-hygiene.mjs",
    "clean": "node ../../scripts/build/clean-dist.mjs",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@principles/core": "file:../core",
    "@principles/codex-adapter": "file:../codex-adapter",
    "@principles/host-runtime": "file:../host-runtime",
    "@principles/install-layout": "file:../install-layout",
    "principles-disciple": "file:../plugin",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuzngjh/principles.git",
    "directory": "packages/pd-cli"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@principles/pd-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && npx tsc",
    "dev": "npx tsx src/server/index.ts --port 3100",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:ui && npx playwright test",
    "test:e2e:owner": "npm run build:ui && npx playwright test --config playwright.owner.config.ts",
    "test:e2e:headed": "npm run build:ui && npx playwright test --headed",
    "typecheck": "npx tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@principles/core": "file:../core",
    "@principles/host-runtime": "file:../host-runtime",
    "@principles/install-layout": "file:../install-layout",
    "principles-disciple": "file:../plugin",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@sinclair/typebox": "^0.34.48",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "js-yaml": "^4.2.0",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}

{
  "name": "create-principles-disciple",
  "version": "1.74.1",
  "description": "Interactive CLI installer for Principles Disciple OpenClaw plugin",
  "type": "module",
  "bin": {
    "create-principles-disciple": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "pd-cli",
    "console",
    "core",
    "host-runtime",
    "install-layout",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "bundle": "node scripts/bundle-plugin.mjs",
    "build:release-asset": "node scripts/build-self-contained-release.mjs",
    "generate:release-locks": "node scripts/generate-release-locks.mjs",
    "check:release-locks": "node scripts/check-release-locks.mjs",
    "prepack": "npm run build && npm run bundle",
    "prepublishOnly": "npm run build && npm run bundle",
    "test": "vitest run"
  },
  "keywords": [
    "openclaw",
    "principles-disciple",
    "cli",
    "installer",
    "interactive"
  ],
  "author": "csuzngjh",
  "license": "MIT",
  "dependencies": {
    "@principles/install-layout": "0.1.0",
    "@tufjs/models": "3.0.1",
    "@inquirer/prompts": "^8.5.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.4.0",
    "js-yaml": "^5.3.0",
    "ora": "^9.4.0",
    "picocolors": "^1.0.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tuf-js": "3.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.0",
    "@types/tar": "^7.0.87",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csuzngjh/principles.git",
    "directory": "packages/create-principles-disciple"
  },
  "pd": {
    "bundledPluginVersion": "1.222.0"
  }
}

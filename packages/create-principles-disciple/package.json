{
  "name": "create-principles-disciple",
  "version": "1.144.3",
  "description": "Interactive CLI installer for Principles Disciple OpenClaw plugin",
  "type": "module",
  "bin": {
    "create-principles-disciple": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./update-console": {
      "types": "./dist/update/console-surface.d.ts",
      "default": "./dist/update/console-surface.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "plugin",
    "pd-cli",
    "console",
    "core",
    "host-runtime",
    "codex-adapter",
    "install-layout",
    "release-manager",
    "trust/root.json",
    "_release/product-identity.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "bundle": "node scripts/bundle-plugin.mjs",
    "build:release-asset": "node scripts/build-self-contained-release.mjs",
    "generate:release-locks": "node scripts/generate-release-locks.mjs",
    "check:release-locks": "node scripts/check-release-locks.mjs",
    "prepack": "npm run build && npm run bundle",
    "prepublishOnly": "npm run build && npm run bundle",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/smoke-packaged-install.test.ts --exclude tests/release-asset-smoke.test.ts --exclude tests/release-upgrade-gate.test.ts",
    "test:smoke:packaged": "vitest run tests/smoke-packaged-install.test.ts",
    "test:smoke:release-asset": "vitest run tests/release-asset-smoke.test.ts"
  },
  "keywords": [
    "openclaw",
    "principles-disciple",
    "cli",
    "installer",
    "interactive"
  ],
  "author": "csuzngjh",
  "license": "MIT",
  "dependencies": {
    "@principles/install-layout": "^0.2.7",
    "@tufjs/models": "3.0.1",
    "@inquirer/prompts": "^8.7.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.4.0",
    "js-yaml": "^5.4.1",
    "ora": "^9.4.1",
    "picocolors": "^1.0.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tuf-js": "3.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.7.0",
    "@types/tar": "^7.0.87",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csuzngjh/principles.git",
    "directory": "packages/create-principles-disciple"
  },
  "pd": {
    "bundledPluginVersion": "2.0.2"
  }
}

{
  "name": "@principles/host-runtime",
  "version": "0.10.4",
  "description": "Shared host-neutral orchestration for Principles Disciple MVP-Core hook paths.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./behavior-example-pack-assembler": {
      "types": "./dist/behavior-example-pack-assembler.d.ts",
      "default": "./dist/behavior-example-pack-assembler.js"
    },
    "./behavior-history": {
      "types": "./dist/behavior-history.d.ts",
      "default": "./dist/behavior-history.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@principles/core": "^1.294.1",
    "@principles/install-layout": "^0.4.0",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuzngjh/principles.git"
  },
  "license": "Apache-2.0"
}

  "provenance": "Unedited real generated code; inputs are sanitized counterfactual fixtures, not historical Owner approvals. Full raw replay evidence remains in the ignored task lab.",
  "implementationCode": "function evaluate(input, helpers) {\n  var action = input.action || {};\n  var kind = action.canonicalKind;\n  if (kind !== 'execute' && kind !== 'write') {\n    return { decision: 'allow', matched: false, reason: '非本原则范围（设计门禁仅约束执行/写入类动作），放行' };\n  }\n  var ctx = input.context || {};\n  var facts = ctx.facts || {};\n  var gate = facts.designGate;\n  if (!gate || typeof gate !== 'object' || typeof gate.resolution !== 'string') {\n    return { decision: 'allow', matched: false, reason: 'context unavailable：设计门禁事实缺失，仅凭参数文本无法判定是否需要设计批准，放行并保留观察' };\n  }\n  var requires = gate.requiresApproval === true;\n  var resolution = gate.resolution;\n  if (gate.revoked === true) {\n    if (requires && (resolution === 'approved' || resolution === 'not_approved')) {\n      return { decision: 'block', matched: true, reason: '该非简单行为变更的设计批准已被撤销（revoked），不得继续编码提交' };\n    }\n    return { decision: 'allow', matched: false, reason: '门禁事实已撤销但本动作不在审批范围内，放行' };\n  }\n  if (requires && resolution === 'not_approved') {\n    return { decision: 'block', matched: true, reason: '受管动作（' + kind + '）所在的非简单行为变更尚未获得 Owner 设计批准（designGate=not_approved），不得编码提交；请先交付SPEC并取得显式确认' };\n  }\n  if (resolution === 'approved' || resolution === 'not_required') {\n    return { decision: 'allow', matched: false, reason: '设计门禁事实为 ' + resolution + '，依据 Owner 意图放行（已批准SPEC范围内或无需批准的正常开发）' };\n  }\n  return { decision: 'allow', matched: false, reason: 'designGate=unknown：未知不等于未批准，不凭单一未知事实阻止正常开发' };\n}",

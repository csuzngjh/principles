{
  "name": "@principles/website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebake": "node scripts/fetch-companion-release.mjs",
    "docs:dev": "npm run prebake && vitepress dev",
    "docs:build": "npm run prebake && vitepress build",
    "docs:preview": "vitepress preview",
    "test:contract": "node --test tests/homepage-contract.test.mjs",
    "test:relay": "vitest run functions/_lib/__tests__/relay-core.test.ts",
    "test": "npm run docs:build && npm run test:contract && npm run test:relay && npm run test:telemetry",
    "test:telemetry": "vitest run functions/_lib/__tests__/telemetry-core.test.ts functions/_lib/__tests__/telemetry-cleanup-core.test.ts functions/_lib/__tests__/product-signals-core.test.ts"
  },
  "devDependencies": {
    "@principles/core": "*",
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.34.5",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.42"
  }
}

{
  "name": "principles-disciple",
  "version": "1.74.1",
  "description": "Teach your AI once. PD turns your corrections into reviewable behavior principles — so the AI never repeats the same mistake.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rulehost-evidence": {
      "types": "./dist/rulehost-evidence.d.ts",
      "default": "./dist/rulehost-evidence.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuzngjh/principles.git",
    "directory": "packages/openclaw-plugin"
  },
  "author": "csuzngjh",
  "license": "MIT",
  "files": [
    "dist",
    "scripts",
    "templates",
    "openclaw.plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/csuzngjh/principles/issues"
  },
  "homepage": "https://github.com/csuzngjh/principles#readme",
  "openclaw": {
    "id": "principles-disciple",
    "name": "Principles Disciple",
    "setupEntry": "./dist/bundle.js",
    "extensions": [
      "./dist/bundle.js"
    ],
    "compat": {
      "pluginApi": "2026.4.4"
    },
    "build": {
      "openclawVersion": "2026.4.4"
    },
    "install": {
      "minHostVersion": "2026.4.4"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "node esbuild.config.js",
    "build:production": "node esbuild.config.js --production && node scripts/verify-build.mjs",
    "prepack": "npm run build:production",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts tests/core tests/service tests/hooks tests/commands tests/utils tests/scripts --exclude tests/commands/evolver.test.ts",
    "test:integration": "vitest run tests/integration/",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "bootstrap-rules": "node scripts/bootstrap-rules.mjs",
    "compile-principles": "node scripts/compile-principles.mjs",
    "sync-plugin": "node scripts/sync-plugin.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.0.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@principles/core": "^1.74.1",
    "@sinclair/typebox": "^0.34.48",
    "better-sqlite3": "^12.9.0",
    "commander": "^12.0.0",
    "js-yaml": "^5.2.0",
    "micromatch": "^4.0.8"
  }
}

{
  "name": "@principles/pd-companion",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "PD Companion — Windows desktop tray app that launches and supervises the PD Console server (PRI-526).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-builder --win nsis",
    "verify-package": "node scripts/verify-package.mjs",
    "check:release-version": "node scripts/check-release-version-consistency.mjs"
  },
  "dependencies": {
    "@principles/install-layout": "^0.8.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6"
  },
  "license": "Apache-2.0"
}

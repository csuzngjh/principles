{
  "name": "@principles/pd-companion",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "PD Companion — Windows desktop tray app that launches and supervises the PD Console server (PRI-526).",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-builder --win nsis",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@principles/install-layout": "^0.2.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^26.1.2"
  }
}

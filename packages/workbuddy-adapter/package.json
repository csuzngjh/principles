{
  "name": "@principles/workbuddy-adapter",
  "version": "0.2.6",
  "description": "WorkBuddy host adapter for Principles Disciple — implements the HostAdapter interface for WorkBuddy's Git Bash command-hook model (ADR-0020 third host, SPEC workbuddy-host-adapter v0.3.0).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pd-hook": {
      "types": "./dist/pd-hook.d.ts",
      "default": "./dist/pd-hook.js"
    },
    "./host-adapter": {
      "types": "./dist/host-adapter.d.ts",
      "default": "./dist/host-adapter.js"
    },
    "./workspace-resolution": {
      "types": "./dist/workspace-resolution.d.ts",
      "default": "./dist/workspace-resolution.js"
    },
    "./tool-semantics": {
      "types": "./dist/tool-semantics.d.ts",
      "default": "./dist/tool-semantics.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@principles/core": "^1.295.0",
    "@principles/host-runtime": "^0.12.0",
    "@principles/install-layout": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuzngjh/principles.git",
    "directory": "packages/workbuddy-adapter"
  },
  "publishConfig": {
    "access": "public"
  }
}

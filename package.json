{
  "name": "principles-disciple-monorepo",
  "version": "1.73.0",
  "description": "Principles Disciple - OpenClaw Plugin Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@principles/core && npm run build --workspace=principles-disciple",
    "lint": "npm run build --workspace=@principles/core && npx eslint packages/**/*.ts --ignore-pattern **/*.test.ts --ignore-pattern **/*.spec.ts --ignore-pattern **/*.d.ts",
    "lint:fix": "npm run build --workspace=@principles/core && npx eslint packages/**/*.ts --ignore-pattern **/*.test.ts --ignore-pattern **/*.spec.ts --ignore-pattern **/*.d.ts --fix",
    "typecheck:openclaw-plugin": "cd packages/openclaw-plugin && npx tsc --noEmit",
    "typecheck:pd-console": "cd packages/pd-console && npx tsc --noEmit",
    "check:generated-artifacts": "node scripts/check-generated-artifacts.cjs",
    "check:error-handbook": "node scripts/check-error-handbook.cjs",
    "verify:merge": "npm run check:generated-artifacts && npm run check:error-handbook && npm run lint && npm run build && npm run build --workspace=@principles/pd-cli && npm run typecheck:openclaw-plugin && npm run typecheck:pd-console",
    "verify:publish": "npm run build && cd packages/openclaw-plugin && npm pack --dry-run",
    "pre-commit": "lint-staged",
    "ai-sprint": "node packages/openclaw-plugin/templates/langs/zh/skills/ai-sprint-orchestration/scripts/run.mjs",
    "ai-sprint:test": "node --test packages/openclaw-plugin/templates/langs/zh/skills/ai-sprint-orchestration/test/*.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "e2e:story-a": "node scripts/e2e-story-a.mjs",
    "version:patch": "cd packages/openclaw-plugin && npm version patch",
    "version:minor": "cd packages/openclaw-plugin && npm version minor",
    "version:major": "cd packages/openclaw-plugin && npm version major"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "eslint"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/tar": "^7.0.87",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "js-yaml": "^4.2.0",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.7",
    "semantic-release": "^25.0.3",
    "semver": "^7.8.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}

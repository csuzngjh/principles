    "version": "v3-20261112",
    "selectThreshold": 0.7,
    "insufficientThreshold": 0.6,
    "note": "A replaceable candidate answers two independent conditions (value + safety); both must clear selectThreshold. The append path keeps one condition per candidate. Fixture scores are synthetic."
  },
  "route": {
    "endpoint": "https://openrouter.ai/api/alpha/decisions",
    "model": "respan/span-01-lite:free",

    "apiKeyEnv": "OPENROUTER_API_KEY",
    "responseModels": [
      "respan/span-01-lite:free",
      "respan/span-01-lite-20260925"
    ]
  },
  "envelope": {
    "totalMs": 2000,
    "measuredFrom": "actual send of the single Decisions request",
    "measuredTo": "the WHOLE answer table passed validation",
    "earlierOf": "send + 2000 ms, or the host window minus the assembly/output reserve"
  },
  "requestBudget": {
    "perCase": 1,
    "total": 4,
    "zeroRequestControl": "pure-ack",
    "note": "The native (Adaptive OFF) comparison run never sends a request."

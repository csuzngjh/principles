  "expiresAt": "2026-11-15T23:59:59+08:00",
  "candidates": {
    "SCOPE": {
      "text": "只修改与任务直接相关的文件，邻近改进记为后续事项。"
    },
    "DRAFT_A": {
      "text": "起草阶段先把所有假设写成选项清单再动笔，适用于纯文案起草，不适用于交付判定。",
      "repeat": 7
    },
    "DRAFT_B": {
      "text": "起草阶段先确认读者与语气，并按章节列出待补充材料；只适用于起草，不适用于交付判定。",
      "repeat": 7
    },
    "BIG": {
      "text": "避免为假设的未来需求预建抽象和额外服务。",
      "repeat": 40
    },
    "DELIVERY": {
      "text": "交付验收前以可观察证据自检：先列出验收基准与已有证据；缺证据时如实限定结论。"
    },
    "TESTS": {
      "text": "修复缺陷时先写能复现问题的回归测试，再改实现。",
      "repeat": 2
    }
  },
  "cases": [
